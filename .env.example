# Reference environment template — copy to `.env.local` and adjust.
# Every variable is read via `import.meta.env` (see `src/vite-env.d.ts`).

# Base URL for the API client, resolved at the service layer (src/services)
# so src/lib stays platform-agnostic (no Vite coupling).
# Relative paths like this are resolved against the app origin.
# Use an absolute URL to target a remote backend from localhost, e.g.:
#   VITE_API_BASE_URL=https://api.example.com
# or a dev proxy, e.g.:
#   VITE_API_BASE_URL=/api
VITE_API_BASE_URL=/api